__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Longhaul's own working state when dogfooding in this repo.
# .longhaul/ itself is meant to be COMMITTED in a target repo — that is the
# whole point — but worktrees and raw run transcripts are not.
.longhaul/worktrees/
.longhaul/runs/

.env
*.local

# The exported interface IS committed — it ships in the wheel so users
# never need Node. Rebuild with `cd web && npm run build`.
!src/longhaul/ui/static/

# Reference screenshots and scratch images. This is a public repository, and
# `git add -A` once swept a screenshot of a private dashboard — account name,
# email and project names — into two commits. Ignore them by default; anything
# genuinely meant to ship goes in docs/ or web/public/ deliberately.
/*.png
/*.jpg
/*.jpeg
/*.webp
/screenshot*
