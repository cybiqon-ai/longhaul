{
  "name": "longhaul-web",
  "private": true,
  "description": "The Longhaul interface. Statically exported and bundled into the Python package at release time, so users never need Node.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && rm -rf ../src/longhaul/ui/static && cp -r out ../src/longhaul/ui/static",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@tanstack/react-table": "8.21.3",
    "recharts": "3.10.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "class-variance-authority": "0.7.1",
    "lucide-react": "0.544.0",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-separator": "1.1.7",
    "date-fns": "4.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.6",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3"
  }
}
